# Existing local LLM Configuration
QWEN_ENDPOINT=http://localhost:8000
OLLAMA_ENDPOINT=http://localhost:11434
MASTER_KEY=your-32-character-master-key-here

# Browser Agent Gateway
BROWSER_PRIMARY_ENGINE=obscura
BROWSER_FALLBACK_ENGINE=playwright
BROWSER_MAX_ENGINE_FALLBACKS=1
BROWSER_DEFAULT_TIMEOUT_MS=15000
BROWSER_ALLOW_PRIVATE_NETWORK=false
BROWSER_REQUIRE_APPROVAL_FOR_SIDE_EFFECTS=true
# WebMCP is an optional owned-app capability adapter (draft browser API). Off by default.
WEBMCP_ENABLED=false

# Obscura integration
# The Project Lead must verify the current upstream MCP/CDP launch contract before setting this.
OBSCURA_MCP_COMMAND=
OBSCURA_MCP_ARGS=

# Browser-operator LLM routing
LLM_OPERATOR_PRIMARY_PROVIDER=deepseek
LLM_OPERATOR_PRIMARY_MODEL=deepseek-v4-flash
LLM_OPERATOR_ESCALATION_PROVIDER=gemini
LLM_OPERATOR_ESCALATION_MODEL=gemini-3.8-flash
LLM_OPERATOR_ALTERNATE_PROVIDER=openai
LLM_OPERATOR_ALTERNATE_MODEL=gpt-5.6-luna

# Provider credentials — keep real values only in .env / secret storage, never commit them.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Search provider credentials (optional; used by Deep Research).
# SEARCH_PROVIDER_ORDER controls the fallback order (default: brave,exa,tavily).
SEARCH_PROVIDER_ORDER=brave,exa,tavily
SEARCH_BRAVE_API_KEY=
SEARCH_EXA_API_KEY=
SEARCH_TAVILY_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Notifications (optional)
NOTIFICATION_EMAIL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook Secret
WEBHOOK_SECRET=your-webhook-secret

# Redis (for queue)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
WS_PORT=8080
