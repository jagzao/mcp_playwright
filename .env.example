# LLM Configuration
QWEN_ENDPOINT=http://localhost:8000
OLLAMA_ENDPOINT=http://localhost:11434
MASTER_KEY=your-32-character-master-key-here

# Optional: OpenAI API Key (if you want to use it as fallback)
# OPENAI_API_KEY=sk-...

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Notifications (optional)
NOTIFICATION_EMAIL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook Secret
WEBHOOK_SECRET=your-webhook-secret

# Redis (for queue)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
WS_PORT=8080
