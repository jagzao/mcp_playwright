{
  "name": "mcp-playwright-automation",
  "version": "1.0.0",
  "description": "MCP Playwright Agent - Autonomous web automation with local LLMs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "tsx scripts/post-install.ts",
    "init": "bash scripts/init.sh",
    "diagnose": "tsx scripts/diagnose.ts",
    "smoke:gateway": "tsx scripts/gateway-smoke.ts",
    "rc:s4-login": "tsx scripts/rc-s4-login.ts",
    "rc:s4-finish": "tsx scripts/rc-s4-finish.ts",
    "rc:s4-restart": "tsx scripts/rc-s4-restart.ts",
    "build": "tsc -b tsconfig.json",
    "dev": "tsx watch console-client/src/index.ts",
    "start": "node dist/console-client/src/index.js",
    "agent": "tsx console-client/src/index.ts agent",
    "record": "tsx console-client/src/index.ts record",
    "replay": "tsx console-client/src/index.ts replay",
    "console": "tsx console-client/src/index.ts console",
    "mcp-server": "tsx mcp-server/src/index.ts",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "setup": "bash scripts/setup-models.sh",
    "verify-models": "tsx scripts/verify-models.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:list": "tsx scripts/backup.ts list",
    "queue:add": "tsx scripts/queue.ts add",
    "queue:status": "tsx scripts/queue.ts status",
    "monitor": "tsx scripts/monitor.ts",
    "stats": "tsx scripts/stats.ts"
  },
  "keywords": [
    "mcp",
    "playwright",
    "automation",
    "ai",
    "llm",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "blessed": "^0.1.81",
    "bull": "^4.12.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "inquirer": "^9.2.12",
    "ioredis": "^5.3.2",
    "marked": "^12.0.0",
    "node-cron": "^3.0.3",
    "obscura-node": "^1.1.1",
    "ora": "^8.0.1",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tesseract.js": "^5.0.4",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/blessed": "^0.1.25",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
